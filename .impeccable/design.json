      "description": "Enamel field with a 2px seam border.",
      "html": "<input class=\"ds-input\" placeholder=\"chess.com or Lichess username\">",
      "css": ".ds-input{min-height:44px;padding:9px 14px 7px;border:2px solid var(--seam,#2a3f73);border-radius:8px;background:var(--ground-2,#13224a);color:var(--ink,#f3efe6);font-family:'Overpass',system-ui,sans-serif;font-size:1rem;transition:border-color .15s}.ds-input::placeholder{color:var(--ink-3,#a3aecb)}.ds-input:hover{border-color:var(--seam-strong,#3e5694)}.ds-input:focus-visible{outline:3px solid var(--focus,#f4ad1f);outline-offset:2px}"
    },
    {
      "name": "Pill Nav",
      "kind": "nav",
      "refersTo": "nav-pill",
      "description": "Topbar nav: pills with a round stop; the current page is a porcelain plate with a scarlet stop.",
      "html": "<nav class=\"ds-nav\"><a href=\"#\" aria-current=\"page\"><i></i>Games</a><a href=\"#\"><i></i>Insights</a><a href=\"#\"><i></i>How it works</a></nav>",
      "css": ".ds-nav{display:flex;gap:4px;font-family:'Overpass',system-ui,sans-serif;}.ds-nav a{display:inline-flex;align-items:center;gap:8px;padding:8px 14px 6px;border-radius:999px;color:var(--ink-2,#ccd2e2);text-decoration:none;font-size:.9375rem;font-weight:700;transition:background-color .15s,color .15s}.ds-nav a i{width:9px;height:9px;border-radius:50%;background:currentColor;opacity:.6}.ds-nav a:hover{color:var(--ink,#f3efe6);background:var(--ground-2,#13224a)}.ds-nav a[aria-current=page]{background:var(--sign,#f3efe6);color:var(--sign-ink,#0d1830)}.ds-nav a[aria-current=page] i{background:var(--m-blunder,#e8432f);opacity:1}.ds-nav a:focus-visible{outline:3px solid var(--focus,#f4ad1f);outline-offset:2px}"
    },
    {
      "name": "Mark Bullet",
      "kind": "chip",
      "refersTo": "mark-bullet",
      "description": "The only carrier of mark colour: a round bullet with its glyph.",
      "html": "<span class=\"ds-tag ds-blunder\" role=\"img\" aria-label=\"Blunder\">??</span> <span class=\"ds-tag ds-inacc\" role=\"img\" aria-label=\"Inaccuracy\">?!</span> <span class=\"ds-tag ds-brill\" role=\"img\" aria-label=\"Brilliant\">!!</span> <span class=\"ds-tag ds-great\" role=\"img\" aria-label=\"Great\">!</span>",
      "css": ".ds-tag{display:inline-grid;place-items:center;width:20px;height:20px;border-radius:50%;font-family:'Overpass',system-ui,sans-serif;font-size:.6875rem;font-weight:900;line-height:1;letter-spacing:-.04em;color:#fff}.ds-blunder{background:var(--m-blunder,#e8432f)}.ds-inacc{background:var(--m-inaccuracy,#f4ad1f);color:#0d1830}.ds-brill{background:var(--m-brilliant,#22b8d6)}.ds-great{background:var(--m-great,#3a78f2)}"
    },
    {
      "name": "Station Sign",
      "kind": "card",
      "refersTo": "station-sign",
      "description": "The move you are on: a porcelain plate with bullet, move, mark, eval tile and the why. No base band.",
      "html": "<section class=\"ds-sign\"><div class=\"ds-sign-head\"><span class=\"ds-sign-tag\">??</span><div><b class=\"ds-sign-move\">23. Qxb7</b><span class=\"ds-sign-mark\">Blunder · Middlegame</span></div><span class=\"ds-sign-eval\">-3.4</span></div><p>The rook on a8 is left to be taken.</p></section>",
      "css": ".ds-sign{padding:20px 22px 24px;background:var(--sign,#f3efe6);color:var(--sign-ink,#0d1830);border-radius:12px;font-family:'Overpass',system-ui,sans-serif;max-width:460px}.ds-sign-head{display:flex;align-items:center;gap:14px}.ds-sign-tag{display:grid;place-items:center;width:46px;height:46px;border-radius:50%;background:var(--m-blunder,#e8432f);color:#fff;font-weight:900;font-size:1.0625rem}.ds-sign-move{display:block;font-size:2rem;font-weight:900;line-height:1;letter-spacing:-.02em}.ds-sign-mark{display:block;margin-top:5px;font-weight:700;font-size:.9375rem;color:var(--sign-ink-2,#3f4d74)}.ds-sign-eval{margin-left:auto;align-self:flex-start;padding:7px 11px 5px;border-radius:7px;background:var(--sign-ink,#0d1830);color:var(--sign,#f3efe6);font-weight:900;font-size:1.125rem;font-variant-numeric:tabular-nums}.ds-sign p{margin:14px 0 0;font-size:1.0625rem;line-height:1.5}"
    },
    {
      "name": "Station List",
      "kind": "custom",
      "refersTo": "station-stop-current",
      "description": "Moves as stops on a porcelain route; the current move is a porcelain plate.",
      "html": "<div class=\"ds-stations\"><div class=\"ds-row\"><span class=\"ds-no\">12</span><button class=\"ds-mv\">Nf3</button><button class=\"ds-mv\" aria-current=\"true\">Bxe4</button></div><div class=\"ds-row\"><span class=\"ds-no\">13</span><button class=\"ds-mv\">O-O</button><button class=\"ds-mv\">Qd7</button></div></div>",
      "css": ".ds-stations{padding-left:6px;border-left:6px solid var(--route,#f3efe6);border-radius:3px;font-family:'Overpass',system-ui,sans-serif;color:var(--ink,#f3efe6);max-width:320px}.ds-row{display:grid;grid-template-columns:38px 1fr 1fr;align-items:center}.ds-no{position:relative;padding-left:8px;color:var(--ink-3,#a3aecb);font-weight:700;font-size:.8125rem;font-variant-numeric:tabular-nums}.ds-no::before{content:'';position:absolute;left:-12px;top:50%;width:11px;height:3px;margin-top:-2px;background:var(--route,#f3efe6)}.ds-mv{min-height:34px;padding:5px 10px 3px;border:0;border-radius:7px;background:none;color:inherit;font:inherit;font-weight:700;font-size:.9375rem;text-align:left;cursor:pointer;transition:background-color .12s}.ds-mv:hover{background:var(--ground-3,#1b2e5e)}.ds-mv[aria-current=true]{background:var(--sign,#f3efe6);color:var(--sign-ink,#0d1830)}.ds-mv:focus-visible{outline:3px solid var(--focus,#f4ad1f);outline-offset:2px}"
    },
    {
      "name": "Station Strip",
      "kind": "custom",
      "refersTo": "panel",
      "description": "Insights figures as stops on one route, never stat cards.",
      "html": "<div class=\"ds-figs\"><div class=\"ds-fig\"><div class=\"ds-l\">Average accuracy</div><div class=\"ds-v\">78.4<small>%</small></div></div><div class=\"ds-fig\"><div class=\"ds-l\">Results</div><div class=\"ds-v\">6–3–1</div></div><div class=\"ds-fig\"><div class=\"ds-l\">Errors per game</div><div class=\"ds-v\">2.1</div></div></div>",
      "css": ".ds-figs{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:14px 24px;padding-top:26px;font-family:'Overpass',system-ui,sans-serif;color:var(--ink,#f3efe6)}.ds-figs::before{content:'';position:absolute;left:7px;right:7px;top:7px;height:4px;border-radius:2px;background:var(--route-under,#2a3f73)}.ds-fig{position:relative}.ds-fig::before{content:'';position:absolute;left:0;top:-26px;width:18px;height:18px;border-radius:50%;background:var(--ground,#0d1830);box-shadow:inset 0 0 0 4px var(--route,#f3efe6)}.ds-l{font-size:.875rem;font-weight:700;color:var(--ink-3,#a3aecb)}.ds-v{margin-top:2px;font-size:1.375rem;font-weight:900;font-variant-numeric:tabular-nums}.ds-v small{font-size:.9375rem;font-weight:700;color:var(--ink-3,#a3aecb)}"
    },
    {
      "name": "Segmented",
      "kind": "chip",
      "refersTo": "nav-pill-current",
      "description": "Two route pills; the checked one is a porcelain plate.",
      "html": "<div class=\"ds-seg\"><label><input type=\"radio\" name=\"s\" checked><span>White</span></label><label><input type=\"radio\" name=\"s\"><span>Black</span></label></div>",
      "css": ".ds-seg{display:inline-flex;padding:3px;border-radius:999px;background:var(--ground-2,#13224a);box-shadow:inset 0 0 0 2px var(--seam,#2a3f73);font-family:'Overpass',system-ui,sans-serif;}.ds-seg label{position:relative;cursor:pointer}.ds-seg input{position:absolute;opacity:0}.ds-seg span{display:block;padding:7px 14px 5px;border-radius:999px;font-weight:700;font-size:.875rem;color:var(--ink-2,#ccd2e2);transition:background-color .15s,color .15s}.ds-seg input:checked+span{background:var(--sign,#f3efe6);color:var(--sign-ink,#0d1830)}.ds-seg input:focus-visible+span{outline:3px solid var(--focus,#f4ad1f);outline-offset:1px}"
    }
  ],
  "narrative": {
    "northStar": "The Night Line",
    "overview": "A game is a journey on one transit line. Phases are fare zones, marked moves are interchanges, and the move you are on is a station sign. The whole app is drawn in that grammar: a midnight enamel ground, porcelain enamel signs that carry the content, a single porcelain route that threads through the review, the games list and Insights, and round route bullets as the only place colour speaks.\n\nDensity is that of a good transit map: few materials, heavy confident labels, everything else quiet. The ground recedes, the sign in front of you is the brightest object on screen, and the route ties the parts together. Night is the default. Day is the same line in daylight: the ground turns porcelain and the signs turn to midnight enamel, by swapping roles rather than inventing a second palette.\n\nThe system rejects the category default it replaced (a dark slate panel with an eval bar and a move table), the sterile dashboard, flash, and clutter. It must not resemble Chess.com or Lichess.",
    "keyCharacteristics": [
      "Two materials only: midnight enamel ground and porcelain enamel signs, swapped in day.",
      "One porcelain route line connects the move list, the line map, the games list and the Insights figures.",
      "Mark colours appear only on round route bullets, always with a glyph.",
      "One face, Overpass, set heavy (800 to 900) for signs and regular for prose.",
      "Controls are rounded platform buttons and pills; containers are 12px enamel plates.",
      "Flat: depth comes from tone and 1px seams, not shadow."
    ],
    "rules": [
      {
        "name": "The Bullet Quarantine Rule",
        "body": "Mark colours live only on round route bullets, and every bullet carries its glyph (!!, !, star, check, dot, book, square, ?!, cross, ?, ??). Never as text colour, never as a band, bar, border or fill behind text. The one exemption is the brand roundel (scarlet ring, cobalt bar) and its echo on the current nav stop.",
        "section": "colors"
      },
      {
        "name": "The Two Materials Rule",
        "body": "Every surface is either ground or sign. Day swaps them; it does not add a third.",
        "section": "colors"
      },
      {
        "name": "The Porcelain Route Rule",
        "body": "The route is one porcelain line (midnight in day), never coloured by result or mark. Emphasis on a route is porcelain over a seam under-stroke; de-emphasis is seam-strong.",
        "section": "colors"
      },
      {
        "name": "The Heavy Sign Rule",
        "body": "Anything you read at a glance (move, eval, accuracy, figure value) is 900 with tabular numerals. Prose stays at 400.",
        "section": "typography"
      },
      {
        "name": "The One Face Rule",
        "body": "Overpass only. No second display face, no monospace for notation.",
        "section": "typography"
      },
      {
        "name": "The Seam Not Shadow Rule",
        "body": "Panels, signs, cards and buttons cast no shadow. Separation is a 1px seam or a change of enamel.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put the thing you are on in porcelain: the current move, page, stop and segmented option.",
      "Do carry every move mark as a round bullet with its glyph, so quality never rests on colour alone.",
      "Do run lists and figure groups along a route line rather than boxing them.",
      "Do separate panels with a 1px inset seam and shift enamel tone for hover.",
      "Do set glanceable numbers in 900 with tabular numerals.",
      "Do build day by swapping ground and sign, keeping mark fills unchanged."
    ],
    "donts": [
      "Don't use a mark colour as text colour, a band, a bar, a border or a background behind text.",
      "Don't put a coloured base band, stripe or edge on a sign.",
      "Don't colour the route by result or mark; it is porcelain (midnight in day).",
      "Don't render Insights figures as stat cards.",
      "Don't add drop shadows to signs, panels or buttons.",
      "Don't introduce a second typeface.",
      "Don't borrow Chess.com or Lichess colours, layouts or board themes."
    ]
  }
}
