APP_NAME=ChessDebrief
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chessdebrief
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: password reset links and bug reports.
# On shared hosting, create a mailbox for the site's domain (e.g. no-reply@yourdomain) and use
# its SMTP details: MAIL_HOST is usually mail.yourdomain, port 587 with MAIL_SCHEME=smtp (STARTTLS),
# or 465 with MAIL_SCHEME=smtps. MAIL_MAILER=sendmail also works where the host allows PHP mail.
# Locally with Laragon: MAIL_HOST=127.0.0.1, MAIL_PORT=1025 (Mailpit, read at http://localhost:8025).
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# The React app's address while developing (Vite). The site's own host is always allowed,
# so in production this line does no harm and needs no change.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Sent to chess.com and Lichess with every request, as both ask: a way to reach you.
CHESSDEBRIEF_CONTACT=you@example.com
# How often each linked chess account is checked for new games.
CHESSDEBRIEF_FETCH_EVERY_HOURS=2
# Accounts of people who have not opened the site for this many days are not checked.
CHESSDEBRIEF_ACTIVE_DAYS=30
# Bug reports from the site's form. Reports are switched off while REPORT_TO is empty.
# REPORT_FROM defaults to MAIL_FROM_ADDRESS; keep it on the site's own domain so mail is not rejected.
CHESSDEBRIEF_REPORT_TO=
CHESSDEBRIEF_REPORT_FROM=
# Reports one visitor can send an hour, and everyone together a day.
CHESSDEBRIEF_REPORT_PER_HOUR=5
CHESSDEBRIEF_REPORT_PER_DAY=200

# The maintenance page at /maintenance.php runs migrations, caches and other artisan commands
# from the browser, for hosts without a command line. Off while empty; use 16+ characters.
CHESSDEBRIEF_ADMIN_PASSWORD=
# Web cron for hosts whose cron jobs cannot run PHP: have something open
# https://your.domain/maintenance.php?cron=<token> every 15 minutes. Off while empty; 16+ characters.
CHESSDEBRIEF_CRON_TOKEN=

# Sign-in with Google. Create an OAuth client (type "Web application") in the Google Cloud
# console and add the redirect address APP_URL/auth/google/callback. Off while empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The "Support ChessDebrief" link (https only): Buy Me a Coffee, Ko-fi, GitHub Sponsors,
# Razorpay Payment Page, PayPal... Hidden while empty.
CHESSDEBRIEF_DONATE_URL=
